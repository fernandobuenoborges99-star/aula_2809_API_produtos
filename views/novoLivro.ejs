<%- include('partials/header') %>

<section class="bg-white p-6 rounded shadow max-w-lg">
  <form action="/livros/novo" method="POST">
    <fieldset class="border p-4 rounded">
      <legend class="font-bold px-2">Cadastrar Livro</legend>

      <label for="titulo" class="block mt-2">Título do Livro</label>
      <input type="text" id="titulo" name="titulo" required class="border p-2 w-full rounded">

      <label for="autor" class="block mt-2">Autor</label>
      <input type="text" id="autor" name="autor" required class="border p-2 w-full rounded">

      <label for="paginas" class="block mt-2">Quantidade de Páginas</label>
      <input type="number" id="paginas" name="paginas" min="1" required class="border p-2 w-full rounded">

      <menu class="mt-4 flex gap-2">
        <li class="list-none"><button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded">Salvar</button></li>
        <li class="list-none"><a href="/livros" class="bg-gray-400 text-white px-4 py-2 rounded inline-block">Cancelar</a></li>
      </menu>
    </fieldset>
  </form>
</section>

<%- include('partials/footer') %>